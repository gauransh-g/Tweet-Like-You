# =============================================================
#  Tweet Like You — Environment Variables Template
#  Copy this file to .env and fill in your actual API keys:
#    cp .env.example .env
# =============================================================

# --- Core LLM (Google Gemini) ---
# Required for tweet generation, editorial angles, and transformations.
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# --- Factual & Real-Time News Grounding ---
# Used for real-time news retrieval and anchor dates.
# Get your free key at: https://newsapi.org/register
NEWS_API_KEY=your_news_api_key_here

# --- Optional Domain Knowledge Plugins ---
# TMDB API (Optional, for cinema / entertainment enrichment):
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# OMDB API (Optional, for movie metadata):
# https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# --- Application Runtime Settings ---
LOG_LEVEL=INFO

# Disable TensorFlow to prevent protobuf version conflicts with google-genai SDK
USE_TF=0
TF_CPP_MIN_LOG_LEVEL=3
