# =============================================================
#  Tweet Like You — .gitignore
# =============================================================

# Environment / secrets
.env
.env*.local
*.env

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environments
venv/
env/
.venv/
ENV/

# Vector Stores & Caches (regenerated on demand)
chroma_db/
data/chroma_db/
.pytest_cache/
.coverage
htmlcov/

# Raw scraped datasets
data/raw/
data/processed/*.parquet
data/processed/*.csv

# Node & Frontend build artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.oxlintrc.json
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Logs & scratch
logs/
*.log
scratch/
.tempmediaStorage/
.system_generated/

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
